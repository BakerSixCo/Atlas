---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { getPosts, getSettings, renderMarkdoc } from '../../lib/content';
import { withBoiseOffset } from '../../lib/schedule';
import { resolveImage } from '../../lib/images';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const posts = await getPosts();
const post = posts.find((p) => p.slug === Astro.props.slug)!;
const html = renderMarkdoc((await post.entry.body()).node);
const cover = resolveImage(post.entry.cover);
const og = cover ? (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : undefined;
const date = post.entry.date ? new Date(`${post.entry.date}T12:00:00Z`) : null;
const settings = await getSettings();
const ev = post.entry.event.discriminant ? post.entry.event.value : null;
const schema: object[] = [{
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.entry.title,
  datePublished: post.entry.date, description: post.entry.summary,
  ...(og ? { image: new URL(og, Astro.site).href } : {}),
  author: { '@type': 'Organization', name: 'Atlas Jiu-Jitsu', url: Astro.site!.href },
  publisher: { '@id': new URL('/#gym', Astro.site).href },
}];
if (ev?.start) {
  schema.push({
    '@context': 'https://schema.org', '@type': 'Event',
    name: post.entry.title, description: post.entry.summary,
    startDate: withBoiseOffset(ev.start),
    ...(ev.end ? { endDate: withBoiseOffset(ev.end) } : {}),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: ev.location
      ? { '@type': 'Place', name: ev.location, address: ev.location }
      : { '@type': 'Place', name: `Atlas Jiu-Jitsu (${settings.locationNote})`, address: { '@type': 'PostalAddress', streetAddress: settings.addressLine1, addressLocality: 'Meridian', addressRegion: 'ID', addressCountry: 'US' } },
    organizer: { '@type': 'Organization', name: 'Atlas Jiu-Jitsu', url: Astro.site!.href },
    ...(og ? { image: [new URL(og, Astro.site).href] } : {}),
    ...(ev.price || ev.registerUrl ? { offers: { '@type': 'Offer', url: ev.registerUrl || new URL(`/news/${post.slug}`, Astro.site).href, ...(ev.price ? { price: ev.price.replace(/[^0-9.]/g, '') || '0', priceCurrency: 'USD' } : {}), availability: 'https://schema.org/InStock' } } : {}),
  });
}
const fmtEvent = (iso: string) => new Date(withBoiseOffset(iso)).toLocaleString('en-US', { timeZone: 'America/Boise', weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit' });
---
<Base title={post.entry.title} description={post.entry.summary || post.entry.title} image={og} schema={schema}>
  <article class="section section--tight">
    <div class="wrap narrow">
      <a class="link-arrow back" href="/news">All news</a>
      {date && <time datetime={post.entry.date}>{date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>}
      <h1>{post.entry.title}</h1>
      {post.entry.summary && <p class="lede">{post.entry.summary}</p>}
      {ev?.start && (
        <div class="card event">
          <p><strong>When</strong> {fmtEvent(ev.start)}{ev.end && ` – ${fmtEvent(ev.end)}`}</p>
          <p><strong>Where</strong> {ev.location || `${settings.locationNote}, ${settings.addressLine1}, ${settings.addressLine2}`}</p>
          {ev.price && <p><strong>Price</strong> {ev.price}</p>}
          {ev.registerUrl && <a class="btn btn--sm" href={ev.registerUrl} rel="noopener" target="_blank">Register</a>}
        </div>
      )}
      {cover && <div class="cover"><Photo src={cover} alt={post.entry.coverAlt} eager sizes="(min-width: 900px) 860px, 100vw" /></div>}
      <div class="prose" set:html={html} />
    </div>
  </article>
</Base>

<style>
  .narrow { max-width: 860px; display: grid; gap: 20px; }
  .back { justify-self: start; }
  .back::after { content: none; }
  .back::before { content: '←'; }
  time { color: var(--red-text); font-weight: 650; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.85rem; margin-top: 16px; }
  h1 { font-size: clamp(2.2rem, 6vw, 4.2rem); }
  .event { display: grid; gap: 6px; justify-items: start; }
  .event strong { display: inline-block; min-width: 64px; color: var(--red-text); }
  .cover { border-radius: var(--radius); overflow: hidden; margin-block: 12px; }
</style>
