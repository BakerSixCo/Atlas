---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { getPosts, renderMarkdoc } from '../../lib/content';
import { resolveImage } from '../../lib/images';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const posts = await getPosts();
const post = posts.find((p) => p.slug === Astro.props.slug)!;
const html = renderMarkdoc((await post.entry.body()).node);
const cover = resolveImage(post.entry.cover);
const og = cover ? (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : undefined;
const date = post.entry.date ? new Date(`${post.entry.date}T12:00:00Z`) : null;
const schema = [{
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.entry.title,
  datePublished: post.entry.date, description: post.entry.summary,
  publisher: { '@id': 'https://atlas-jiujitsu.com/#gym' },
}];
---
<Base title={post.entry.title} description={post.entry.summary || post.entry.title} image={og} schema={schema}>
  <article class="section section--tight">
    <div class="wrap narrow">
      <a class="link-arrow back" href="/news">All news</a>
      {date && <time datetime={post.entry.date}>{date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>}
      <h1>{post.entry.title}</h1>
      {post.entry.summary && <p class="lede">{post.entry.summary}</p>}
      {cover && <div class="cover"><Photo src={cover} alt={post.entry.coverAlt} eager sizes="(min-width: 900px) 860px, 100vw" /></div>}
      <div class="prose" set:html={html} />
    </div>
  </article>
</Base>

<style>
  .narrow { max-width: 860px; display: grid; gap: 20px; }
  .back { justify-self: start; }
  .back::after { content: none; }
  .back::before { content: '←'; }
  time { color: var(--red-text); font-weight: 650; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.85rem; margin-top: 16px; }
  h1 { font-size: clamp(2.2rem, 6vw, 4.2rem); }
  .cover { border-radius: var(--radius); overflow: hidden; margin-block: 12px; }
</style>
