---
import { Image } from 'astro:assets';
import mark from '../assets/images/brand/mark.png';
import Icon from './Icon.astro';
import { publicPath } from '../lib/url';

interface Props { signupUrl?: string; signupLabel?: string }
const { signupUrl, signupLabel = 'Sign up' } = Astro.props;
const path = publicPath(Astro.url.pathname);
const nav = [
  { href: '/schedule', label: 'Schedule' },
  { href: '/programs', label: 'Programs' },
  { href: '/programs/beginners', label: 'Start here' },
  { href: '/about', label: 'About' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
];
// Highlight only the most specific matching item (so /programs/beginners lights "Start here", not "Programs").
const current = nav
  .filter((n) => path === n.href || path.startsWith(n.href + '/'))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
const isCurrent = (href: string) => href === current;
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Atlas Jiu-Jitsu home">
      <Image src={mark} alt="" width={44} densities={[1, 2]} loading="eager" />
      <span class="brand-text"><span>Atlas</span><small>Jiu-Jitsu</small></span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      {signupUrl && <a class="btn btn--sm" href={signupUrl} rel="noopener" target="_blank">{signupLabel}</a>}
      <details class="menu" data-menu>
        <summary class="menu-btn">
          <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
          <span class="sr-only">Menu</span>
        </summary>
        <nav class="mobile-nav" aria-label="Mobile">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
          {signupUrl && <a class="btn" href={signupUrl} rel="noopener" target="_blank">{signupLabel}</a>}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(10, 10, 10, 0.72);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, background 0.3s;
  }
  .site-header.is-scrolled { border-bottom-color: var(--line); background: rgba(10, 10, 10, 0.88); }
  .bar { height: var(--header-h); display: flex; align-items: center; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex: none; }
  .brand img { width: 44px; height: auto; }
  .brand-text { display: grid; line-height: 1; }
  .brand-text span {
    font-family: var(--font-display); font-variation-settings: 'wdth' 125; font-weight: 850;
    font-size: 1.25rem; letter-spacing: 0.04em; text-transform: uppercase;
  }
  .brand-text small { font-size: 0.62rem; letter-spacing: 0.32em; text-transform: uppercase; color: var(--muted); margin-top: 3px; }
  .nav { margin-left: auto; display: none; }
  .nav ul { display: flex; gap: 4px; list-style: none; padding: 0; }
  .nav a {
    display: block; padding: 8px 12px; border-radius: 999px; text-decoration: none;
    font-size: 0.92rem; font-weight: 550; color: var(--muted); transition: color 0.2s, background 0.2s;
  }
  .nav a:hover { color: var(--text); background: rgba(255, 255, 255, 0.06); }
  .nav a[aria-current='page'] { color: var(--text); background: rgba(255, 255, 255, 0.1); }
  .actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .menu-btn {
    width: 44px; height: 44px; display: grid; place-items: center; list-style: none; cursor: pointer;
    background: transparent; border: 1px solid var(--line); border-radius: 999px;
  }
  .menu-btn::-webkit-details-marker { display: none; }
  .menu-btn :global(svg) { width: 22px; height: 22px; grid-area: 1 / 1; }
  .menu-btn :global(.i-close) { display: none; }
  .menu[open] .menu-btn :global(.i-open) { display: none; }
  .menu[open] .menu-btn :global(.i-close) { display: block; }
  .mobile-nav {
    position: absolute; top: 100%; left: 0; right: 0; z-index: 60;
    height: calc(100dvh - var(--header-h)); overflow-y: auto;
    border-top: 1px solid var(--line); background: var(--bg);
    padding: 12px var(--gutter) 24px;
  }
  .mobile-nav ul { list-style: none; padding: 0; margin-bottom: 20px; }
  .mobile-nav a:not(.btn) {
    display: block; padding: 14px 0; border-bottom: 1px solid var(--line); text-decoration: none;
    font-family: var(--font-display); font-variation-settings: 'wdth' 120; font-weight: 800;
    font-size: 1.6rem; text-transform: uppercase;
  }
  .mobile-nav a[aria-current='page'] { color: var(--red-text); }
  .mobile-nav .btn { width: 100%; }
  @media (min-width: 1000px) {
    .nav { display: block; }
    .actions { margin-left: 8px; }
    .menu { display: none; }
  }
  @media (max-width: 420px) { .actions .btn--sm { display: none; } }
</style>
