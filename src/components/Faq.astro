---
// Native <details> accordion: accessible and works without JavaScript.
interface Props { items: { question: string; answer: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f, i) => (
    <details name="faq" open={i === 0}>
      <summary><span>{f.question}</span><span class="plus" aria-hidden="true"></span></summary>
      <p>{f.answer}</p>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; gap: 10px; }
  details { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); transition: border-color 0.2s; }
  details[open] { border-color: #3a3a3a; }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px;
    padding: 20px 22px; font-weight: 650; font-size: 1.05rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--red-text); }
  .plus { position: relative; width: 16px; height: 16px; flex: none; }
  .plus::before, .plus::after { content: ''; position: absolute; inset: 7px 0 auto; height: 2px; background: currentColor; transition: transform 0.25s var(--ease); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0); }
  details p { padding: 0 22px 22px; color: var(--muted); max-width: 65ch; }
</style>
