---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveImage } from '../lib/images';

interface Props {
  src: string | ImageMetadata | null | undefined;
  alt: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  eager?: boolean;
}
const { src, alt, sizes = '100vw', widths = [480, 800, 1200, 1600, 2200], class: cls, eager = false } = Astro.props;
const img = typeof src === 'string' || !src ? resolveImage(src as string) : src;
const usable = img ? widths.filter((w) => w <= img.width) : [];
if (img && !usable.length) usable.push(img.width);
---
{img && (
  <Picture
    src={img}
    alt={alt}
    widths={usable}
    sizes={sizes}
    formats={['avif', 'webp']}
    class={cls}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
)}
