---
// Filled in by src/scripts/site.ts; hidden until then so no-JS visitors never see an empty pill.
interface Props { class?: string }
---
<p class:list={['live', Astro.props.class]} data-live-status hidden>
  <span class="chip chip--live" data-live-chip>Next</span>
  <span data-live-text></span>
</p>

<style>
  .live {
    display: inline-flex; align-items: center; flex-wrap: wrap; gap: 12px;
    padding: 10px 18px 10px 10px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    font-size: 0.95rem;
  }
  .live[data-state='next'] .chip--live, .live[data-state='closed'] .chip--live { background: rgba(255,255,255,0.14); }
  .live[data-state='next'] .chip--live::before, .live[data-state='closed'] .chip--live::before { animation: none; }
  .live :global(strong) { font-weight: 700; }
</style>
