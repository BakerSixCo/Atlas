---
import { byDay, DAY_ORDER, DAY_NAMES, fmtRange, LEVEL_LABELS, PROGRAM_LABELS, type ClassItem, type Day } from '../lib/schedule';

interface Props { classes: ClassItem[]; compact?: boolean }
const { classes, compact = false } = Astro.props;
const days = byDay(classes);
// Always show Mon–Sat so the week reads naturally; show Sunday only if something is on it.
const shown: Day[] = DAY_ORDER.filter((d) => d !== 'sun' || days.sun.length);
---
<div class:list={['week', `cols-${shown.length}`, { compact }]}>
  {shown.map((d) => (
    <section class="day" data-day={d} data-day-group id={compact ? undefined : `day-${d}`} aria-labelledby={`h-${d}${compact ? '-c' : ''}`}>
      <header>
        <h3 id={`h-${d}${compact ? '-c' : ''}`}>
          <span class="long">{DAY_NAMES[d]}</span><span class="short" aria-hidden="true">{DAY_NAMES[d].slice(0, 3)}</span>
        </h3>
        <span class="today-tag">Today</span>
      </header>
      {days[d].length ? (
        <ul>
          {days[d].map((s) => (
            <li class="session" data-session data-program={s.program} data-day={d} data-start={s.start} data-end={s.end}>
              <time>{fmtRange(s.start, s.end)}</time>
              <strong>{s.title}</strong>
              {!compact && (
                <span class="meta">
                  <span class="prog">{PROGRAM_LABELS[s.program] ?? s.program}</span>
                  <span>{LEVEL_LABELS[s.level] ?? s.level}</span>
                </span>
              )}
              <span class="live-tag">Live now</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="rest">Rest day</p>
      )}
      <p class="rest filtered">No classes match</p>
    </section>
  ))}
</div>

<style>
  .cols-6 { --cols: 6; }
  .cols-7 { --cols: 7; }
  .week { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .week { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .week { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 10px; } }

  .day {
    position: relative; background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 18px 14px 14px;
    transition: border-color 0.3s;
  }
  .day.is-today { border-color: var(--red); box-shadow: 0 0 0 1px var(--red) inset; }
  .day header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; padding-inline: 4px; }
  .day h3 { font-size: 1rem; letter-spacing: 0.12em; text-transform: uppercase; font-variation-settings: 'wdth' 118; }
  .short { display: none; }
  @media (min-width: 1000px) { .long { display: none; } .short { display: inline; } }
  .today-tag { display: none; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #fff; background: var(--red); padding: 3px 8px; border-radius: 999px; }
  .day.is-today .today-tag { display: inline-block; }

  ul { list-style: none; padding: 0; display: grid; gap: 8px; }
  .session {
    position: relative; display: grid; gap: 4px;
    padding: 12px 12px 12px 16px; border-radius: var(--radius-sm);
    background: var(--surface-2); overflow: hidden;
  }
  .session::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--prog, var(--red)); }
  .session time { font-variant-numeric: tabular-nums; font-size: 0.85rem; color: var(--muted); font-weight: 600; }
  .session strong { font-size: 0.98rem; line-height: 1.3; font-weight: 650; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: 0.76rem; color: var(--muted); }
  .meta .prog { color: var(--prog); font-weight: 650; }
  .live-tag { display: none; justify-self: start; margin-top: 4px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; background: var(--red); color: #fff; padding: 2px 8px; border-radius: 999px; }
  .session.is-live { box-shadow: 0 0 0 1px var(--red) inset; }
  .session.is-live .live-tag { display: inline-block; }
  .rest { color: var(--muted); font-size: 0.9rem; padding: 6px 4px 10px; }
  .rest.filtered { display: none; }
  .day.is-empty .rest.filtered { display: block; }
  .day.is-empty ul { display: none; }
  .day:not(:has(ul)) .rest.filtered { display: none; }

  .compact .session { padding: 10px 10px 10px 14px; }
  .compact .session strong { font-size: 0.9rem; }
  @media (max-width: 639px) {
    .compact .day:not(:has(.session)) { display: none; }
  }
</style>
