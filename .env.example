# Set ONE of these in Cloudflare → Worker → Settings → Variables (build variables),
# then redeploy. See README → "Editing the site".

# Option A (easiest): Keystatic Cloud project, e.g. "atlas/atlas-jiujitsu"
PUBLIC_KEYSTATIC_CLOUD_PROJECT=

# Option B: your own GitHub App (also needs KEYSTATIC_GITHUB_CLIENT_ID,
# KEYSTATIC_GITHUB_CLIENT_SECRET and KEYSTATIC_SECRET as secrets)
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
