// Cloudflare Workers config. The Astro adapter merges this with what it generates in dist/server.
// "name" must match the Worker name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Free-trial form emails. Locked to this one address, so the form can never email anyone else.
  // Requires: domain on Cloudflare DNS + Email Routing enabled + this address verified (README).
  "send_email": [{ "name": "EMAIL", "destination_address": "atlasjiujitsu90@gmail.com" }]
}
